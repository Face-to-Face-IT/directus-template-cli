{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>Face-to-Face-IT/.github:renovate-config"],
  "packageRules": [
    {
      "description": "Group oclif ecosystem",
      "matchPackagePatterns": ["^@oclif/", "^oclif"],
      "groupName": "oclif"
    },
    {
      "description": "Group Directus SDK packages",
      "matchPackagePatterns": ["^@directus/"],
      "groupName": "directus",
      "automerge": false
    },
    {
      "description": "Group Inquirer/Clack prompts",
      "matchPackagePatterns": ["^@inquirer/", "^@clack/"],
      "groupName": "prompts"
    },
    {
      "description": "Ignore major version updates (match previous Dependabot behavior)",
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ]
}
